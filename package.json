{
  "name": "robust-computer",
  "private": true,
  "version": "0.15.2",
  "description": "Robust Computer — small developer studio, public website. Monorepo root.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:prod": "node scripts/dev.js --env=prod",
    "dev:landing": "cd landing && yarn dev",
    "dev:server": "cd server && yarn dev",
    "mail": "node scripts/mailpit.js",
    "feeds:build": "node scripts/build-rss.mjs --no-broadcast",
    "feeds:broadcast-dev": "node scripts/build-rss.mjs --no-write",
    "feeds:broadcast": "NODE_ENV=production node scripts/build-rss.mjs --no-write",
    "feeds:preview": "node scripts/smoke-feeds.mjs --preview",
    "reset:db": "node scripts/reset-db.mjs",
    "smoke:landing": "node scripts/smoke-landing.mjs",
    "smoke:feeds": "node scripts/smoke-feeds.mjs",
    "smoke:server": "node scripts/smoke-server.mjs",
    "install:all": "yarn install && cd landing && yarn install && cd ../server && yarn install"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "concurrently": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^30.1.2",
    "mongoose": "^8.6.0",
    "puppeteer": "^25.13.0",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  }
}
